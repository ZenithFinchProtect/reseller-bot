# ===== REQUIRED =====
# Bot token from https://discord.com/developers/applications (Bot > Reset Token)
DISCORD_TOKEN=

# Reseller API key for the NFA backend (keep secret).
NFA_API_KEY=
NFA_API_BASE=https://nfa-api.acode.ing

# ===== RECOMMENDED =====
# Your server (guild) ID -> slash commands appear INSTANTLY. Leave blank to
# register globally (can take up to ~1h the first time).
GUILD_ID=

# ===== STOCK =====
# Cap the displayed stock count (matches main-site embeds). 0 = no cap.
STOCK_CAP=5
# How often (minutes) registered server webhooks get a stock update.
STOCK_UPDATE_MINUTES=30

# ===== COSMETIC =====
EMBED_COLOR=0x33C2FF
STOCK_EMBED_TITLE=Nordic Stock Update
WEBHOOK_USERNAME=Nordic Stock
WEBHOOK_AVATAR_URL=
BOT_STATUS_TEXT=nordicnfas.com
ACTIVATION_URL=https://nordicnfas.com/

# ===== ADVANCED =====
DB_PATH=reseller_data.db
# Reserved for future admin-only actions (space/comma separated user IDs).
ADMIN_USER_IDS=
